@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Join HomeGrown";
}

<div class="auth-logo-mobile mb-4">
    <svg width="32" height="32" viewBox="0 0 28 28" fill="none">
        <path d="M14 3C14 3 5 9 5 17C5 21.418 9.134 25 14 25C18.866 25 23 21.418 23 17C23 9 14 3 14 3Z" fill="#87A878"/>
        <path d="M14 8C14 8 9 12 9 17C9 19.761 11.239 22 14 22C16.761 22 19 19.761 19 17C19 12 14 8 14 8Z" fill="#2D5016" opacity="0.4"/>
    </svg>
    <span class="auth-logo-text">HomeGrown</span>
</div>

<h2 class="auth-heading">Join the community.</h2>
<p class="auth-subheading">Connect with local farmers and eat with intention. It's free to get started.</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-sm mb-4">
        <i class="bi bi-exclamation-circle me-2"></i>@ViewBag.Error
    </div>
}

<form asp-controller="Account" asp-action="Register" method="post">
    <div class="mb-3">
        <label class="form-label auth-label">Full Name</label>
        <input type="text" name="name" class="form-control auth-input" placeholder="Jane Smith" required autocomplete="name" />
    </div>
    <div class="mb-3">
        <label class="form-label auth-label">Email Address</label>
        <input type="email" name="email" class="form-control auth-input" placeholder="jane@example.com" required autocomplete="email" />
    </div>
    <div class="mb-3">
        <label class="form-label auth-label">Password</label>
        <input type="password" name="password" class="form-control auth-input" placeholder="Create a password (min 8 characters)" required minlength="8" />
    </div>

    <div class="mb-4">
        <label class="form-label auth-label">I am a...</label>
        <div class="account-type-grid">
            <label class="account-type-option">
                <input type="radio" name="accountType" value="consumer" checked class="account-type-radio" />
                <div class="account-type-card">
                    <i class="bi bi-bag-heart account-type-icon"></i>
                    <strong>Consumer</strong>
                    <small>I want to buy local food</small>
                </div>
            </label>
            <label class="account-type-option">
                <input type="radio" name="accountType" value="farmer" class="account-type-radio" />
                <div class="account-type-card">
                    <i class="bi bi-tree account-type-icon"></i>
                    <strong>Farmer / Artisan</strong>
                    <small>I want to sell my products</small>
                </div>
            </label>
        </div>
    </div>

    <button type="submit" class="btn btn-forest w-100 btn-lg">Create Account</button>
    <p class="auth-fine-print mt-2">By creating an account, you agree to our Terms of Service and Privacy Policy.</p>
</form>

<p class="auth-switch-text mt-4">
    Already have an account?
    <a asp-controller="Account" asp-action="Login" class="auth-switch-link">Sign in here</a>
</p>
