# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit real secrets.

# ─── Database ─────────────────────────────────────────────────────────────────
# Local development (matches docker-compose.yml defaults)
DATABASE_URL=Host=localhost;Port=5432;Database=homegrown;Username=homegrown;Password=homegrown_dev

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_64_char_random_secret
JWT_ISSUER=HomeGrown
JWT_AUDIENCE=HomeGrownClients

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
